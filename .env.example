PORT=3001
# Use 0.0.0.0 to serve the built app to the local network.
HOST=127.0.0.1
DB_PATH=./data/finance.sqlite
MAX_UPLOAD_BYTES=8388608
# Set to 1 when serving through HTTPS.
COOKIE_SECURE=0

# Optional GitHub OAuth
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://127.0.0.1:3001/api/auth/github/callback
